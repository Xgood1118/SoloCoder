<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>菜单管理 - 内部运营系统</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="layout-wrapper">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <i class="bi bi-shield-lock me-2"></i>运营系统
      </div>
      <ul class="nav flex-column" id="sidebar-menu"></ul>
    </aside>
    <div class="main-content">
      <div class="topbar">
        <h1><i class="bi bi-list-nested me-2"></i>菜单管理</h1>
        <div class="user-section">
          <div id="user-info"></div>
          <a href="#" id="logout-btn" class="btn-logout">
            <i class="bi bi-box-arrow-right me-1"></i>退出
          </a>
        </div>
      </div>

      <div class="alert-box alert-box-info">
        <i class="bi bi-info-circle fs-5"></i>
        <div>
          <strong>SQL 注入防护</strong>：所有数据库查询均使用参数化查询（Prepared Statement），
          用户输入不会直接拼接到 SQL 语句中，有效防止 SQL 注入攻击。
        </div>
      </div>

      <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="mb-0">菜单列表</h3>
          <button class="btn btn-success" onclick="openAddModal()">
            <i class="bi bi-plus-lg me-1"></i>新增菜单
          </button>
        </div>

        <div id="alert-area"></div>

        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>菜单名称</th>
              <th>路径</th>
              <th>图标</th>
              <th>上级菜单</th>
              <th>排序</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="menu-table-body">
            <tr><td colspan="7" class="text-center py-4 text-muted">加载中...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="modal fade" id="menuModal" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modal-title">新增菜单</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" id="edit-id">
              <div class="mb-3">
                <label class="form-label">菜单名称</label>
                <input type="text" class="form-control" id="edit-name" placeholder="请输入菜单名称">
              </div>
              <div class="mb-3">
                <label class="form-label">上级菜单</label>
                <select class="form-control" id="edit-parent-id">
                  <option value="0">无（顶级菜单）</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">路径</label>
                <input type="text" class="form-control" id="edit-path" placeholder="请输入访问路径，如 /customers">
              </div>
              <div class="mb-3">
                <label class="form-label">图标</label>
                <input type="text" class="form-control" id="edit-icon" placeholder="请输入 Bootstrap 图标名，如 people">
                <small class="text-muted">参考：https://icons.getbootstrap.com/</small>
              </div>
              <div class="mb-3">
                <label class="form-label">排序</label>
                <input type="number" class="form-control" id="edit-sort-order" value="0" placeholder="数字越小越靠前">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
              <button type="button" class="btn btn-primary" onclick="saveMenu()">保存</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    let menus = [];
    let menuModal;

    document.addEventListener('DOMContentLoaded', () => {
      menuModal = new bootstrap.Modal(document.getElementById('menuModal'));
      loadData();
    });

    async function loadData() {
      menus = await API.getAllMenus() || [];
      renderParentOptions();
      renderTable();
    }

    function renderParentOptions() {
      const select = document.getElementById('edit-parent-id');
      const topMenus = menus.filter(m => m.parent_id === 0);
      select.innerHTML = '<option value="0">无（顶级菜单）</option>' +
        topMenus.map(m => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join('');
    }

    function renderTable() {
      const tbody = document.getElementById('menu-table-body');
      if (menus.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">暂无数据</td></tr>';
        return;
      }

      const menuMap = new Map(menus.map(m => [m.id, m]));

      tbody.innerHTML = menus.sort((a, b) => a.sort_order - b.sort_order).map(m => `
        <tr>
          <td><span class="badge bg-secondary">${m.id}</span></td>
          <td>${m.parent_id > 0 ? '&nbsp;&nbsp;&nbsp;└─ ' : ''}${escapeHtml(m.name)}</td>
          <td><code>${escapeHtml(m.path || '-')}</code></td>
          <td><i class="bi bi-${m.icon || 'circle'}"></i> ${m.icon || '-'}</td>
          <td>${m.parent_id === 0 ? '<span class="badge badge-success">顶级菜单</span>' : escapeHtml(menuMap.get(m.parent_id)?.name || '-')}</td>
          <td>${m.sort_order}</td>
          <td>
            <button class="btn btn-sm btn-primary" onclick="editMenu(${m.id})">编辑</button>
            <button class="btn btn-sm btn-danger" onclick="deleteMenu(${m.id})">删除</button>
          </td>
        </tr>
      `).join('');
    }

    function openAddModal() {
      document.getElementById('modal-title').textContent = '新增菜单';
      document.getElementById('edit-id').value = '';
      document.getElementById('edit-name').value = '';
      document.getElementById('edit-parent-id').value = '0';
      document.getElementById('edit-path').value = '';
      document.getElementById('edit-icon').value = '';
      document.getElementById('edit-sort-order').value = '0';
      menuModal.show();
    }

    function editMenu(id) {
      const menu = menus.find(m => m.id === id);
      if (!menu) return;

      document.getElementById('modal-title').textContent = '编辑菜单';
      document.getElementById('edit-id').value = menu.id;
      document.getElementById('edit-name').value = menu.name;
      document.getElementById('edit-parent-id').value = menu.parent_id;
      document.getElementById('edit-path').value = menu.path || '';
      document.getElementById('edit-icon').value = menu.icon || '';
      document.getElementById('edit-sort-order').value = menu.sort_order;
      menuModal.show();
    }

    async function saveMenu() {
      const id = document.getElementById('edit-id').value;
      const data = {
        name: document.getElementById('edit-name').value.trim(),
        parent_id: parseInt(document.getElementById('edit-parent-id').value),
        path: document.getElementById('edit-path').value.trim(),
        icon: document.getElementById('edit-icon').value.trim(),
        sort_order: parseInt(document.getElementById('edit-sort-order').value) || 0
      };

      if (!data.name) {
        showAlert('菜单名称不能为空', 'warning');
        return;
      }

      let result;
      if (id) {
        const res = await API.request(`/api/menus/${id}`, {
          method: 'PUT',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      } else {
        const res = await API.request('/api/menus', {
          method: 'POST',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      }

      if (result) {
        showAlert(result.message, result.error ? 'danger' : 'success');
        if (!result.error) {
          menuModal.hide();
          loadData();
        }
      }
    }

    async function deleteMenu(id) {
      const hasChildren = menus.some(m => m.parent_id === id);
      if (hasChildren) {
        showAlert('该菜单存在子菜单，请先删除子菜单', 'warning');
        return;
      }

      if (!confirm('确定要删除该菜单吗？删除后相关角色的菜单权限也会被移除。')) return;

      const res = await API.request(`/api/menus/${id}`, { method: 'DELETE' });
      const result = res ? await res.json() : null;

      if (result) {
        showAlert(result.message, 'success');
        loadData();
      }
    }

    function showAlert(message, type) {
      const alertArea = document.getElementById('alert-area');
      alertArea.innerHTML = `
        <div class="alert-box alert-box-${type}">
          <i class="bi bi-${type === 'success' ? 'check-circle' : 'x-circle'} fs-5"></i>
          <div>${message}</div>
        </div>
      `;
      setTimeout(() => { alertArea.innerHTML = ''; }, 5000);
    }
  </script>
</body>
</html>
