<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 - 内部运营系统</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="auth-page">
  <div class="auth-wrapper">
    <div class="auth-card">
      <h2><i class="bi bi-person-plus me-2"></i>用户注册</h2>
      <div id="alert-container"></div>
      <form id="registerForm">
        <div class="form-group">
          <label for="username">用户名</label>
          <input type="text" id="username" name="username" placeholder="请输入用户名">
        </div>
        <div class="form-group">
          <label for="email">邮箱</label>
          <input type="email" id="email" name="email" placeholder="请输入邮箱">
        </div>
        <div class="form-group">
          <label for="phone">手机号</label>
          <input type="tel" id="phone" name="phone" placeholder="请输入手机号">
        </div>
        <div class="form-group">
          <label for="password">密码 <small class="text-muted">(至少8位，包含字母和数字)</small></label>
          <input type="password" id="password" name="password" placeholder="请输入密码" required>
          <div class="mt-1">
            <small id="passwordStrength" class="text-muted"></small>
          </div>
        </div>
        <button type="submit" class="btn-primary">注 册</button>
      </form>
      <div class="auth-footer">
        已有账号？<a href="/login">立即登录</a>
      </div>
    </div>
  </div>

  <script>
    const passwordInput = document.getElementById('password');
    const strengthText = document.getElementById('passwordStrength');

    passwordInput.addEventListener('input', () => {
      const pwd = passwordInput.value;
      let strength = '';
      let color = 'text-muted';

      if (pwd.length >= 8) {
        const hasLetter = /[A-Za-z]/.test(pwd);
        const hasNumber = /\d/.test(pwd);
        if (hasLetter && hasNumber) {
          strength = '✓ 密码强度符合要求';
          color = 'text-success';
        } else if (!hasLetter) {
          strength = '✗ 需要包含字母';
          color = 'text-danger';
        } else if (!hasNumber) {
          strength = '✗ 需要包含数字';
          color = 'text-danger';
        }
      } else if (pwd.length > 0) {
        strength = '✗ 密码长度不足8位';
        color = 'text-danger';
      }

      strengthText.textContent = strength;
      strengthText.className = color;
    });

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = document.getElementById('username').value.trim();
      const email = document.getElementById('email').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const password = document.getElementById('password').value;

      const result = await API.register(username, email, phone, password);
      const alertContainer = document.getElementById('alert-container');

      if (result.ok) {
        alertContainer.innerHTML = '<div class="alert alert-success">注册成功，正在跳转到登录页...</div>';
        setTimeout(() => { window.location.href = '/login'; }, 1000);
      } else {
        const errors = result.data.errors ? result.data.errors.map(e => e.msg).join(', ') : result.data.message;
        alertContainer.innerHTML = '<div class="alert alert-danger">' + errors + '</div>';
      }
    });
  </script>
</body>
</html>
