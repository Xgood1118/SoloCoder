<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>用户管理 - 内部运营系统</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="layout-wrapper">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <i class="bi bi-shield-lock me-2"></i>运营系统
      </div>
      <ul class="nav flex-column" id="sidebar-menu"></ul>
    </aside>
    <div class="main-content">
      <div class="topbar">
        <h1><i class="bi bi-people-fill me-2"></i>用户管理</h1>
        <div class="user-section">
          <div id="user-info"></div>
          <a href="#" id="logout-btn" class="btn-logout">
            <i class="bi bi-box-arrow-right me-1"></i>退出
          </a>
        </div>
      </div>

      <div class="alert-box alert-box-info">
        <i class="bi bi-info-circle fs-5"></i>
        <div>
          <strong>XSS 防护说明</strong>：用户输入的用户名、邮箱等内容在入库前会经过 XSS 转义，
          前端渲染时也会使用 <code>textContent</code> 或 <code>escapeHtml()</code> 函数进行转义，
          防止恶意脚本执行。
        </div>
      </div>

      <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="mb-0">用户列表</h3>
          <button class="btn btn-success" onclick="openAddModal()">
            <i class="bi bi-plus-lg me-1"></i>新增用户
          </button>
        </div>

        <div id="alert-area"></div>

        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>用户名</th>
              <th>邮箱</th>
              <th>手机号</th>
              <th>角色</th>
              <th>团队ID</th>
              <th>创建时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="user-table-body">
            <tr><td colspan="8" class="text-center py-4 text-muted">加载中...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="modal fade" id="userModal" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modal-title">新增用户</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" id="edit-id">
              <div class="mb-3">
                <label class="form-label">用户名</label>
                <input type="text" class="form-control" id="edit-username" placeholder="请输入用户名">
              </div>
              <div class="mb-3">
                <label class="form-label">邮箱</label>
                <input type="email" class="form-control" id="edit-email" placeholder="请输入邮箱">
              </div>
              <div class="mb-3">
                <label class="form-label">手机号</label>
                <input type="text" class="form-control" id="edit-phone" placeholder="请输入手机号">
              </div>
              <div class="mb-3" id="password-field">
                <label class="form-label">密码 <small class="text-muted">(至少8位，包含字母和数字)</small></label>
                <input type="password" class="form-control" id="edit-password" placeholder="请输入密码">
              </div>
              <div class="mb-3">
                <label class="form-label">角色</label>
                <select class="form-control" id="edit-role-id"></select>
              </div>
              <div class="mb-3">
                <label class="form-label">团队ID</label>
                <input type="number" class="form-control" id="edit-team-id" placeholder="请输入团队ID（可选）">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
              <button type="button" class="btn btn-primary" onclick="saveUser()">保存</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    let users = [];
    let roles = [];
    let userModal;

    document.addEventListener('DOMContentLoaded', () => {
      userModal = new bootstrap.Modal(document.getElementById('userModal'));
      loadData();
    });

    async function loadData() {
      users = await API.getUsers() || [];
      roles = await API.getRoles() || [];
      renderRoleOptions();
      renderTable();
    }

    function renderRoleOptions() {
      const select = document.getElementById('edit-role-id');
      select.innerHTML = roles.map(r =>
        `<option value="${r.id}">${escapeHtml(r.name)}</option>`
      ).join('');
    }

    function renderTable() {
      const tbody = document.getElementById('user-table-body');
      if (users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">暂无数据</td></tr>';
        return;
      }

      tbody.innerHTML = users.map(u => `
        <tr>
          <td><span class="badge bg-secondary">${u.id}</span></td>
          <td>${escapeHtml(u.username || '-')}</td>
          <td>${escapeHtml(u.email || '-')}</td>
          <td>${escapeHtml(u.phone || '-')}</td>
          <td><span class="badge bg-info">${escapeHtml(u.role_name || '-')}</span></td>
          <td>${u.team_id || '-'}</td>
          <td>${new Date(u.created_at).toLocaleString()}</td>
          <td>
            <button class="btn btn-sm btn-primary" onclick="editUser(${u.id})">编辑</button>
            <button class="btn btn-sm btn-danger" onclick="deleteUser(${u.id})">删除</button>
          </td>
        </tr>
      `).join('');
    }

    function openAddModal() {
      document.getElementById('modal-title').textContent = '新增用户';
      document.getElementById('edit-id').value = '';
      document.getElementById('edit-username').value = '';
      document.getElementById('edit-email').value = '';
      document.getElementById('edit-phone').value = '';
      document.getElementById('edit-password').value = '';
      document.getElementById('password-field').style.display = 'block';
      document.getElementById('edit-role-id').value = roles.find(r => r.name === '普通销售')?.id || 4;
      document.getElementById('edit-team-id').value = '';
      userModal.show();
    }

    function editUser(id) {
      const user = users.find(u => u.id === id);
      if (!user) return;

      document.getElementById('modal-title').textContent = '编辑用户';
      document.getElementById('edit-id').value = user.id;
      document.getElementById('edit-username').value = user.username || '';
      document.getElementById('edit-email').value = user.email || '';
      document.getElementById('edit-phone').value = user.phone || '';
      document.getElementById('edit-password').value = '';
      document.getElementById('password-field').style.display = 'none';
      document.getElementById('edit-role-id').value = user.role_id;
      document.getElementById('edit-team-id').value = user.team_id || '';
      userModal.show();
    }

    async function saveUser() {
      const id = document.getElementById('edit-id').value;
      const data = {
        username: document.getElementById('edit-username').value.trim(),
        email: document.getElementById('edit-email').value.trim(),
        phone: document.getElementById('edit-phone').value.trim(),
        role_id: parseInt(document.getElementById('edit-role-id').value),
        team_id: document.getElementById('edit-team-id').value || null
      };

      const password = document.getElementById('edit-password').value;
      if (!id && !password) {
        showAlert('请输入密码', 'warning');
        return;
      }
      if (password) data.password = password;

      if (!data.username && !data.email && !data.phone) {
        showAlert('用户名、邮箱、手机号至少填写一个', 'warning');
        return;
      }

      let result;
      if (id) {
        const res = await API.request(`/api/users/${id}`, {
          method: 'PUT',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      } else {
        const res = await API.request('/api/users', {
          method: 'POST',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      }

      if (result) {
        showAlert(result.message, result.errors || result.error ? 'danger' : 'success');
        if (!result.errors && !result.error) {
          userModal.hide();
          loadData();
        }
      }
    }

    async function deleteUser(id) {
      if (!confirm('确定要删除该用户吗？')) return;

      const res = await API.request(`/api/users/${id}`, { method: 'DELETE' });
      const result = res ? await res.json() : null;

      if (result) {
        showAlert(result.message, 'success');
        loadData();
      }
    }

    function showAlert(message, type) {
      const alertArea = document.getElementById('alert-area');
      alertArea.innerHTML = `
        <div class="alert-box alert-box-${type}">
          <i class="bi bi-${type === 'success' ? 'check-circle' : 'x-circle'} fs-5"></i>
          <div>${message}</div>
        </div>
      `;
      setTimeout(() => { alertArea.innerHTML = ''; }, 5000);
    }
  </script>
</body>
</html>
