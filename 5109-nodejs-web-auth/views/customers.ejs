<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>客户管理 - 内部运营系统</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="layout-wrapper">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <i class="bi bi-shield-lock me-2"></i>运营系统
      </div>
      <ul class="nav flex-column" id="sidebar-menu"></ul>
    </aside>
    <div class="main-content">
      <div class="topbar">
        <h1><i class="bi bi-people me-2"></i>客户管理</h1>
        <div class="user-section">
          <div id="user-info"></div>
          <a href="#" id="logout-btn" class="btn-logout">
            <i class="bi bi-box-arrow-right me-1"></i>退出
          </a>
        </div>
      </div>

      <div class="alert-box alert-box-info" id="data-scope-alert">
        <i class="bi bi-info-circle fs-5"></i>
        <div id="data-scope-text">正在加载数据权限...</div>
      </div>

      <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="mb-0">客户列表</h3>
          <div class="d-flex gap-3">
            <div class="input-group" style="width: 300px;">
              <input type="number" id="search-id" class="form-control" placeholder="输入客户ID查询（测试越权）">
              <button class="btn btn-primary" onclick="searchCustomer()">
                <i class="bi bi-search me-1"></i>查询
              </button>
            </div>
            <button class="btn btn-success" onclick="openAddModal()">
              <i class="bi bi-plus-lg me-1"></i>新增客户
            </button>
          </div>
        </div>

        <div id="alert-area"></div>

        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>客户名称</th>
              <th>手机号</th>
              <th>邮箱</th>
              <th>公司</th>
              <th>负责人ID</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody id="customer-table-body">
            <tr><td colspan="7" class="text-center py-4 text-muted">加载中...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="modal fade" id="customerModal" tabindex="-1">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modal-title">新增客户</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" id="edit-id">
              <div class="mb-3">
                <label class="form-label">客户名称</label>
                <input type="text" class="form-control" id="edit-name" placeholder="请输入客户名称">
              </div>
              <div class="mb-3">
                <label class="form-label">手机号</label>
                <input type="text" class="form-control" id="edit-phone" placeholder="请输入手机号">
              </div>
              <div class="mb-3">
                <label class="form-label">邮箱</label>
                <input type="email" class="form-control" id="edit-email" placeholder="请输入邮箱">
              </div>
              <div class="mb-3">
                <label class="form-label">公司</label>
                <input type="text" class="form-control" id="edit-company" placeholder="请输入公司名称">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
              <button type="button" class="btn btn-primary" onclick="saveCustomer()">保存</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script>
    let customers = [];
    let customerModal;

    document.addEventListener('DOMContentLoaded', () => {
      customerModal = new bootstrap.Modal(document.getElementById('customerModal'));
      loadCustomers();
    });

    async function loadCustomers() {
      const result = await API.getCustomers();
      const alertArea = document.getElementById('alert-area');

      if (result) {
        customers = result.data || [];
        renderDataScope(result.dataScope);
        renderTable();
      }
    }

    function renderDataScope(scope) {
      const alertEl = document.getElementById('data-scope-alert');
      const textEl = document.getElementById('data-scope-text');
      let scopeText = '', scopeClass = '';

      if (scope === 'all') {
        scopeText = '当前数据权限：<strong>全部</strong> - 可查看所有客户数据';
        scopeClass = 'alert-box-warning';
      } else if (scope === 'team') {
        scopeText = '当前数据权限：<strong>团队</strong> - 只能查看本团队客户数据';
        scopeClass = 'alert-box-info';
      } else {
        scopeText = '当前数据权限：<strong>个人</strong> - 只能查看自己负责的客户数据';
        scopeClass = 'alert-box-success';
      }

      textEl.innerHTML = scopeText + '<br><small class="text-muted">尝试在搜索框输入其他用户的客户ID，系统会拦截越权访问</small>';
      alertEl.className = 'alert-box ' + scopeClass;
    }

    function renderTable() {
      const tbody = document.getElementById('customer-table-body');
      if (customers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">暂无数据</td></tr>';
        return;
      }

      tbody.innerHTML = customers.map(c => `
        <tr>
          <td><span class="badge bg-secondary">${c.id}</span></td>
          <td>${escapeHtml(c.name)}</td>
          <td>${escapeHtml(c.phone || '-')}</td>
          <td>${escapeHtml(c.email || '-')}</td>
          <td>${escapeHtml(c.company || '-')}</td>
          <td><span class="badge bg-info">${c.owner_id}</span></td>
          <td>
            <button class="btn btn-sm btn-primary" onclick="editCustomer(${c.id})">编辑</button>
            <button class="btn btn-sm btn-danger" onclick="deleteCustomer(${c.id})">删除</button>
          </td>
        </tr>
      `).join('');
    }

    async function searchCustomer() {
      const id = document.getElementById('search-id').value;
      if (!id) {
        showAlert('请输入客户ID', 'warning');
        return;
      }

      const result = await API.getCustomerById(id);
      const alertArea = document.getElementById('alert-area');

      if (result && result.errorCode === 'IDOR_BLOCKED') {
        showAlert(result.message, 'danger');
      } else if (result) {
        showAlert(`查询成功：客户名称 - ${escapeHtml(result.name)}`, 'success');
      } else {
        showAlert('客户不存在', 'warning');
      }
    }

    function showAlert(message, type) {
      const alertArea = document.getElementById('alert-area');
      alertArea.innerHTML = `
        <div class="alert-box alert-box-${type}">
          <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'danger' ? 'x-circle' : 'exclamation-triangle'} fs-5"></i>
          <div>${message}</div>
        </div>
      `;
      setTimeout(() => { alertArea.innerHTML = ''; }, 5000);
    }

    function openAddModal() {
      document.getElementById('modal-title').textContent = '新增客户';
      document.getElementById('edit-id').value = '';
      document.getElementById('edit-name').value = '';
      document.getElementById('edit-phone').value = '';
      document.getElementById('edit-email').value = '';
      document.getElementById('edit-company').value = '';
      customerModal.show();
    }

    function editCustomer(id) {
      const customer = customers.find(c => c.id === id);
      if (!customer) return;

      document.getElementById('modal-title').textContent = '编辑客户';
      document.getElementById('edit-id').value = customer.id;
      document.getElementById('edit-name').value = customer.name;
      document.getElementById('edit-phone').value = customer.phone || '';
      document.getElementById('edit-email').value = customer.email || '';
      document.getElementById('edit-company').value = customer.company || '';
      customerModal.show();
    }

    async function saveCustomer() {
      const id = document.getElementById('edit-id').value;
      const data = {
        name: document.getElementById('edit-name').value.trim(),
        phone: document.getElementById('edit-phone').value.trim(),
        email: document.getElementById('edit-email').value.trim(),
        company: document.getElementById('edit-company').value.trim()
      };

      if (!data.name) {
        showAlert('客户名称不能为空', 'warning');
        return;
      }

      let result;
      if (id) {
        const res = await API.request(`/api/customers/${id}`, {
          method: 'PUT',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      } else {
        const res = await API.request('/api/customers', {
          method: 'POST',
          body: JSON.stringify(data)
        });
        result = res ? await res.json() : null;
      }

      if (result && result.errorCode === 'IDOR_BLOCKED') {
        showAlert(result.message, 'danger');
      } else if (result) {
        showAlert(result.message, 'success');
        customerModal.hide();
        loadCustomers();
      }
    }

    async function deleteCustomer(id) {
      if (!confirm('确定要删除该客户吗？')) return;

      const res = await API.request(`/api/customers/${id}`, { method: 'DELETE' });
      const result = res ? await res.json() : null;

      if (result && result.errorCode === 'IDOR_BLOCKED') {
        showAlert(result.message, 'danger');
      } else if (result) {
        showAlert(result.message, 'success');
        loadCustomers();
      }
    }
  </script>
</body>
</html>
