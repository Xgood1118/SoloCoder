{
  "entity_type": "contact",
  "direction": "crm_to_marketing",
  "source_primary_key": "id",
  "target_primary_key": "uuid",
  "deduplication_fields": ["phone", "email"],
  "mappings": [
    {
      "source_field": "id",
      "target_field": "crm_id",
      "direction": "crm_to_marketing",
      "required": true
    },
    {
      "source_field": "customer_id",
      "target_field": "company_id",
      "direction": "crm_to_marketing"
    },
    {
      "source_field": "name",
      "target_field": "name",
      "direction": "bidirectional",
      "required": true
    },
    {
      "source_field": "phone",
      "target_field": "phone",
      "direction": "bidirectional",
      "required": true,
      "conversion": {
        "type": "phone_format",
        "params": {
          "add_prefix": true,
          "prefix": "86"
        }
      }
    },
    {
      "source_field": "email",
      "target_field": "email",
      "direction": "bidirectional",
      "required": true
    },
    {
      "source_field": "position",
      "target_field": "title",
      "direction": "bidirectional"
    },
    {
      "source_field": "department",
      "target_field": "department",
      "direction": "bidirectional"
    },
    {
      "source_field": "is_default",
      "target_field": "is_primary",
      "direction": "bidirectional",
      "default_value": false
    },
    {
      "source_field": "is_active",
      "target_field": "status",
      "direction": "bidirectional",
      "conversion": {
        "type": "enum_mapping",
        "params": {
          "mapping": {
            "true": "active",
            "false": "inactive"
          }
        }
      }
    },
    {
      "source_field": "created_at",
      "target_field": "created_time",
      "direction": "crm_to_marketing",
      "conversion": {
        "type": "date_format",
        "params": {
          "source_format": "%Y-%m-%d %H:%M:%S",
          "target_format": "%Y-%m-%dT%H:%M:%SZ"
        }
      }
    }
  ]
}
