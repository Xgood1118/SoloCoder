APP_NAME=crm-sync-service
APP_ENV=development
DEBUG=true

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/crm_sync
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CRM_API_BASE_URL=http://crm.example.com/api
CRM_API_KEY=your_crm_api_key
CRM_API_TIMEOUT=30

MARKETING_API_BASE_URL=http://marketing.example.com/api
MARKETING_API_KEY=your_marketing_api_key
MARKETING_API_TIMEOUT=30

SYNC_BATCH_SIZE=100
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_INITIAL_WAIT=1
SYNC_MAX_DELAY_MINUTES=5

ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
ALERT_ENABLED=false

LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/crm_sync.log

SYNC_CUSTOMER_CRON=*/5 * * * *
SYNC_CONTACT_CRON=*/5 * * * *
SYNC_LEAD_CRON=*/2 * * * *
SYNC_ORDER_CRON=*/10 * * * *

TIMEZONE=Asia/Shanghai
