# Rust build artifacts
/target/
Cargo.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Editor backup files
*.bak
*.tmp

# Debug files
*.dSYM/
*.pdb

# Release builds (optional - some repos prefer to keep builds out)
