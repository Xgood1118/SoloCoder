.env
.env.local
.env.*.local
config.local.toml

# Log files
*.log
logs/

# Backup crates index (generated on first build, not needed in repo)
# .cargo-checksum.json is generated locally

# WebAssembly build output
*.wasm
*.wat

# Temp
tmp/
temp/
*.tmp