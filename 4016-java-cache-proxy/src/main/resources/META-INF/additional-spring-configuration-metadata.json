{
  "groups": [
    {
      "name": "cache.proxy",
      "type": "com.cacheproxy.config.CacheProxyProperties",
      "description": "Two-level cache proxy configuration properties."
    }
  ],
  "properties": [
    {
      "name": "cache.proxy.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable cache proxy.",
      "defaultValue": true
    },
    {
      "name": "cache.proxy.l1.default-ttl",
      "type": "java.lang.Long",
      "description": "Default TTL for L1 (Caffeine) cache.",
      "defaultValue": 300
    },
    {
      "name": "cache.proxy.l1.maximum-size",
      "type": "java.lang.Long",
      "description": "Maximum size for L1 (Caffeine) cache.",
      "defaultValue": 10000
    },
    {
      "name": "cache.proxy.l2.default-ttl",
      "type": "java.lang.Long",
      "description": "Default TTL for L2 (Redis) cache.",
      "defaultValue": 3600
    },
    {
      "name": "cache.proxy.l2.key-prefix",
      "type": "java.lang.String",
      "description": "Key prefix for L2 (Redis) cache.",
      "defaultValue": "cache:proxy:"
    },
    {
      "name": "cache.proxy.pubsub.channel",
      "type": "java.lang.String",
      "description": "Redis Pub/Sub channel for cache eviction events.",
      "defaultValue": "cache:proxy:evict"
    },
    {
      "name": "cache.proxy.pubsub.instance-id",
      "type": "java.lang.String",
      "description": "Instance ID for Pub/Sub message filtering.",
      "defaultValue": "default"
    },
    {
      "name": "cache.proxy.penetration.enabled",
      "type": "java.lang.Boolean",
      "description": "Enable cache penetration protection with Bloom filter.",
      "defaultValue": true
    },
    {
      "name": "cache.proxy.penetration.miss-threshold",
      "type": "java.lang.Integer",
      "description": "Number of consecutive misses before adding to Bloom filter.",
      "defaultValue": 3
    }
  ]
}
