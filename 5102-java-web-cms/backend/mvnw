# ----------------------------------------------------------------------------
# Maven Wrapper 启动脚本，用于在未安装 Maven 的环境（Linux/Mac）
# ----------------------------------------------------------------------------

MAVEN_VERSION="3.9.6"
MAVEN_BASE_URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_DIR="${SCRIPT_DIR}/maven-temp"
MAVEN_HOME="${MAVEN_DIR}/apache-maven-${MAVEN_VERSION}"

if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
    echo "[INFO] Downloading Maven ${MAVEN_VERSION}..."
    mkdir -p "${MAVEN_DIR}"
    curl -L -o "${MAVEN_DIR}/maven.tar.gz" "${MAVEN_BASE_URL}"
    echo "[INFO] Extracting Maven..."
    tar -xzf "${MAVEN_DIR}/maven.tar.gz" -C "${MAVEN_DIR}"
    rm "${MAVEN_DIR}/maven.tar.gz"
fi

export PATH="${MAVEN_HOME}/bin:${PATH}"
"${MAVEN_HOME}/bin/mvn" "$@"
