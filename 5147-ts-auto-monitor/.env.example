# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Metric Collection
COLLECTION_INTERVAL=15000
METRIC_RETENTION_DAYS=7

# Alert Rules Configuration
ALERT_RULES_FILE=./config/alert-rules.txt
RULE_RELOAD_INTERVAL=30000

# Database (for historical data)
DB_TYPE=sqlite
DB_PATH=./data/metrics.db

# Notification Channels - WeChat Work
WECHAT_WORK_WEBHOOK=
WECHAT_WORK_ENABLED=false

# Notification Channels - DingTalk
DINGTALK_WEBHOOK=
DINGTALK_ENABLED=false
DINGTALK_SECRET=

# Notification Channels - Email
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=monitor@example.com
EMAIL_TO=
EMAIL_ENABLED=false

# Notification Channels - Webhook
WEBHOOK_URL=
WEBHOOK_ENABLED=false
WEBHOOK_METHOD=POST
WEBHOOK_TIMEOUT=5000

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PREFIX=monitor_

# Instance Identification
INSTANCE_ID=monitor-01
SERVICE_NAME=ts-auto-monitor
ENV=development

# Business Metrics API
BUSINESS_METRICS_API=http://localhost:8080/metrics
BUSINESS_METRICS_TIMEOUT=5000
