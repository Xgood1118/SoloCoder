    {
      "chunk_id": "doc_ab6bd50ab85c2abe_chunk_2",
      "document_id": "doc_ab6bd50ab85c2abe",
      "document_name": "sample_document.md",
      "content": "检索增强生成（Retrieval-Augmented Generation，RAG）是一种结合了信息检索和文本生成的 AI 技术框架。 它通过从外部知识库中检索相关文档片段，然后将这些片段作为上下文提供给大语言模型，从而生成更准确、更相关的回答。",
      "chunk_index": 2,
      "start_position": 12,
      "end_position": 135,
      "token_count": 97,
      "element_type": "paragraph",
      "page_number": null,
      "metadata": {
        "text_direction": "horizontal"
      },
      "content_hash": "dbd82719bd3dcecc528c474866bd58952e54e4135ce9519c71aab4fba39f3a26"
    },
