{
  "name": "ts-metrics-collector",
  "version": "1.0.0",
  "description": "A comprehensive TypeScript metrics collector for infrastructure and business metrics",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "example": "ts-node examples/basic-usage.ts"
  },
  "keywords": [
    "metrics",
    "prometheus",
    "monitoring",
    "typescript",
    "observability"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "optionalDependencies": {
    "@clickhouse/client": "^0.2.0",
    "@influxdata/influxdb-client": "^1.33.0",
    "pg": "^8.11.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
