{
  "name": "ts-search-engine",
  "version": "1.0.0",
  "description": "A lightweight full-text search engine built with TypeScript and Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "koa": "2.15.3",
    "koa-bodyparser": "4.4.1",
    "@koa/router": "15.6.0",
    "segmentit": "2.0.3",
    "pinyin-pro": "3.25.0",
    "stemmer": "2.0.1",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/koa": "2.15.0",
    "@types/koa__router": "12.0.4",
    "@types/koa-bodyparser": "4.3.12",
    "@types/node": "^20.14.2",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/index.ts"
    ],
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^segmentit$": "<rootDir>/node_modules/segmentit/dist/segmentit.js",
      "^pinyin-pro$": "<rootDir>/node_modules/pinyin-pro/dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
