<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.audit</groupId>
    <artifactId>audit-log-system</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Audit Log System</name>

    <modules>
        <module>audit-common</module>
        <module>audit-mask</module>
        <module>audit-logger</module>
        <module>audit-storage</module>
        <module>audit-alarm</module>
        <module>audit-report</module>
        <module>audit-api</module>
        <module>audit-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <elasticsearch.version>8.13.2</elasticsearch.version>
        <clickhouse.version>0.6.0</clickhouse.version>
        <mongodb.version>4.11.2</mongodb.version>
        <easyexcel.version>3.3.4</easyexcel.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-mask</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-logger</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-alarm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-report</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.audit</groupId>
                <artifactId>audit-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.clickhouse</groupId>
                <artifactId>clickhouse-jdbc</artifactId>
                <version>${clickhouse.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
