<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ordersystem.query.repository.OrderQueryMapper">

    <resultMap id="OrderDetailVOResultMap" type="com.ordersystem.query.model.OrderDetailVO">
        <id column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="order_type" property="orderType"/>
        <result column="status" property="status" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="freight_amount" property="freightAmount"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <association property="address" javaType="com.ordersystem.query.model.OrderAddressVO">
            <result column="province" property="province"/>
            <result column="city" property="city"/>
            <result column="district" property="district"/>
            <result column="detail_address" property="detailAddress"/>
            <result column="receiver_name" property="receiverName"/>
            <result column="receiver_phone" property="receiverPhone"/>
        </association>
        <association property="discountInfo" javaType="com.ordersystem.query.model.OrderDiscountVO">
            <result column="coupon_id" property="couponId"/>
            <result column="coupon_name" property="couponName"/>
            <result column="coupon_amount" property="couponAmount"/>
            <result column="point_amount" property="pointAmount"/>
            <result column="promotion_amount" property="promotionAmount"/>
        </association>
    </resultMap>

    <resultMap id="OrderStatusHistoryResultMap" type="com.ordersystem.query.model.OrderStatusHistory">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="from_status" property="fromStatus" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="to_status" property="toStatus" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
        <result column="operator" property="operator"/>
        <result column="reason" property="reason"/>
        <result column="operated_at" property="operatedAt"/>
    </resultMap>

    <sql id="conditionWhere">
        <where>
            <if test="condition.userId != null and condition.userId != ''">
                AND o.user_id = #{condition.userId}
            </if>
            <if test="condition.orderNo != null and condition.orderNo != ''">
                AND o.order_no LIKE CONCAT('%', #{condition.orderNo}, '%')
            </if>
            <if test="condition.skuName != null and condition.skuName != ''">
                AND EXISTS (SELECT 1 FROM t_order_item oi WHERE oi.order_id = o.order_id AND oi.sku_name LIKE CONCAT('%', #{condition.skuName}, '%'))
            </if>
            <if test="condition.receiverName != null and condition.receiverName != ''">
                AND EXISTS (SELECT 1 FROM t_order_address oa WHERE oa.order_id = o.order_id AND oa.receiver_name LIKE CONCAT('%', #{condition.receiverName}, '%'))
            </if>
            <if test="condition.status != null">
                AND o.status = #{condition.status}
            </if>
            <if test="condition.startTime != null">
                AND o.created_at >= #{condition.startTime}
            </if>
            <if test="condition.endTime != null">
                AND o.created_at &lt;= #{condition.endTime}
            </if>
        </where>
    </sql>

    <select id="findByCondition" resultMap="OrderDetailVOResultMap">
        SELECT o.order_id, o.order_no, o.user_id, o.order_type, o.status,
               o.total_amount, o.pay_amount, o.discount_amount, o.freight_amount,
               o.created_at, o.updated_at,
               oa.province, oa.city, oa.district, oa.detail_address, oa.receiver_name, oa.receiver_phone,
               od.coupon_id, od.coupon_name, od.coupon_amount, od.point_amount, od.promotion_amount
        FROM t_order o
        LEFT JOIN t_order_address oa ON oa.order_id = o.order_id
        LEFT JOIN t_order_discount od ON od.order_id = o.order_id
        <include refid="conditionWhere"/>
        ORDER BY o.created_at DESC
    </select>

    <select id="findDetailByOrderNo" resultMap="OrderDetailVOResultMap">
        SELECT o.order_id, o.order_no, o.user_id, o.order_type, o.status,
               o.total_amount, o.pay_amount, o.discount_amount, o.freight_amount,
               o.created_at, o.updated_at,
               oa.province, oa.city, oa.district, oa.detail_address, oa.receiver_name, oa.receiver_phone,
               od.coupon_id, od.coupon_name, od.coupon_amount, od.point_amount, od.promotion_amount
        FROM t_order o
        LEFT JOIN t_order_address oa ON oa.order_id = o.order_id
        LEFT JOIN t_order_discount od ON od.order_id = o.order_id
        WHERE o.order_no = #{orderNo}
        LIMIT 1
    </select>

    <select id="findStatusHistory" resultMap="OrderStatusHistoryResultMap">
        SELECT id, order_no, from_status, to_status, operator, reason, operated_at
        FROM t_order_status_history
        WHERE order_no = #{orderNo}
        ORDER BY operated_at DESC
    </select>

    <insert id="insertStatusHistory">
        INSERT INTO t_order_status_history (order_no, from_status, to_status, operator, reason, operated_at)
        VALUES (#{orderNo}, #{fromStatus}, #{toStatus}, #{operator}, #{reason}, #{operatedAt})
    </insert>

</mapper>
