{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "age"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "age": {"type": "integer", "minimum": 0, "maximum": 150},
    "email": {"type": "string", "pattern": "^[^@]+@[^@]+$"},
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    }
  }
}
