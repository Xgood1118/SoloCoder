{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {"$ref": "#/definitions/item"},
      "minItems": 1
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "integer"},
        "value": {"type": "string"}
      }
    }
  }
}
